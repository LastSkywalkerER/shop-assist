VITE_GEOAPIFY_KEY=your_geoapify_api_key_here

# Supabase Configuration
# Get these values from: https://app.supabase.com/project/YOUR_PROJECT/settings/api

# Project URL (format: https://PROJECT_REF.supabase.co)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable/Anon Key (safe to expose in frontend)
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_publishable_key_here

# VAPID public key for Web Push (PWA notifications).
# Generate a key pair once with: npx web-push generate-vapid-keys
# Use the SAME publicKey here AND in the send-notification edge function secret
# VAPID_PUBLIC_KEY. Also set VAPID_PRIVATE_KEY and VAPID_SUBJECT=mailto:you@...
# in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Supabase admin access (server-side only — never exposed to the frontend)

# Service/secret key. Use it for calls that go through the data API: invoking
# Edge Functions, scripts that need to bypass RLS.
# Where: Dashboard → Project Settings → API Keys → `service_role` / `secret`.
# NOTE: this key CANNOT run migrations. It authenticates against PostgREST,
# which only reads and writes rows — it has no way to execute DDL
# (CREATE TABLE / ALTER TABLE). Use one of the two below for that.
SUPABASE_SECRET_KEY=your_service_role_or_secret_key_here

# Personal access token — the credential `scripts/apply-migration.sh` uses to
# run a migration through the Management API.
# Where: https://supabase.com/dashboard/account/tokens → "Generate new token"
# (account-level, not inside the project; shown once, starts with `sbp_`).
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token_here

# Direct Postgres connection string — the psql alternative for the same script.
# Where: Dashboard → Project Settings → Database → Connection string → URI,
# then replace [YOUR-PASSWORD] with the database password from the same page.
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Telegram Bot Configuration
# Get this from @BotFather: https://t.me/botfather

# Bot Token (used only in Edge Function, not exposed to frontend)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Bot username without @ (used for invite deep links in Edge Function)
BOT_USERNAME=YourBotUsername

# Telegram Mini App short name as set in BotFather /myapps
MINI_APP_SLUG=yourminiappslug

# Development Settings (optional)

# Enable Eruda mobile debugger in production
# Add ?debug=1 to URL or uncomment this line
# VITE_ENABLE_DEBUG=true

# Instructions:
# 1. Copy this file to .env.local
# 2. Fill in your actual values
# 3. Never commit .env.local to version control
